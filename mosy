#!/bin/bash

# Parse global flags
while [[ "$1" == -* ]]; do
    case "$1" in
        -p|--profile)
            export MOSY_PROFILE="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

# Load core logic after setting potential MOSY_PROFILE override
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/src/core.sh"

case "$1" in
    add|init|pull|list|status|doctor|info|diff|history|rollback|backup|edit|which|clean|tree|remove|uninstall|config|version|update|link)
        source "${SCRIPT_DIR}/src/commands/${1}.sh"
        "cmd_${1}" "${@:2}"
        ;;
    snapshot)
        source "${SCRIPT_DIR}/src/commands/backup.sh"
        cmd_snapshot "${@:2}"
        ;;
    *)
        echo "Usage: mosy [-p|--profile <name>] <command> [args]"
        echo "Commands:"
        echo "  add <file_or_directory>  Add an item to the cloud vault"
        echo "  link <local> [target]    Map local path to existing cloud vault item"
        echo "  init                    Configure PC from sync map"
        echo "  pull                    Link missing items from cloud vault"
        echo "  list                    List all managed items"
        echo "  status                  Show system and file integrity status"
        echo "  doctor [--fix]          Diagnose system health and auto-repair issues"
        echo "  info [--json]           Show environment and managed items overview"
        echo "  diff [path] [options]   Inspect differences against backups or vault"
        echo "  history [path] [--json] List timestamped backup snapshots"
        echo "  rollback <path> [time]  Restore a previous backup snapshot"
        echo "  backup [path] [options] Create timestamped safety backup snapshots"
        echo "  snapshot [path]         Alias for backup command"
        echo "  edit <item> [options]   Open managed dotfile in EDITOR with auto-backup"
        echo "  which <path> [--json]   Inspect if a local path is managed by MountSync"
        echo "  clean [path] [options]  Purge obsolete backup snapshots"
        echo "  tree [options]          Render visual hierarchy tree of managed items"
        echo "  remove <path>           Stop syncing an item and make it local"
        echo "  uninstall               Remove MountSync from your system"
        echo "  config                  Manage configuration"
        echo "  version                 Show installed version"
        echo "  update                  Update MountSync to latest version"
        exit 1
        ;;
esac
