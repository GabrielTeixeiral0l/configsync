#compdef mosy

_mosy() {
    local line state

    _arguments -C \
        '1: :->cmd' \
        '*:: :->args'

    case $state in
        cmd)
            local -a subcmds
            subcmds=(
                'add:Add an item to the cloud vault'
                'init:Configure PC from sync map'
                'pull:Link missing items from cloud vault'
                'list:List all managed items'
                'status:Show system and file integrity status'
                'doctor:Diagnose system health and auto-repair issues'
                'info:Show environment and managed items overview'
                'diff:Inspect differences against backups or vault'
                'history:List timestamped backup snapshots'
                'rollback:Restore a previous backup snapshot'
                'backup:Create timestamped safety backup snapshots'
                'snapshot:Alias for backup command'
                'edit:Open managed dotfile in EDITOR with auto-backup'
                'which:Inspect if a local path is managed by MountSync'
                'clean:Purge obsolete backup snapshots'
                'tree:Render visual hierarchy tree of managed items'
                'remove:Stop syncing an item and make it local'
                'uninstall:Remove MountSync from your system'
                'config:Manage configuration'
                'version:Show installed version'
                'update:Update MountSync to latest version'
                'link:Map local path to existing cloud vault item'
            )
            _describe "commands" subcmds
            ;;
        args)
            case $line[1] in
                add)
                    _arguments \
                        '--tag[Filter tags]:tags:' \
                        '-t[Filter tags]:tags:' \
                        '--group[Filter groups]:groups:' \
                        '-g[Filter groups]:groups:' \
                        '--link[Cloud vault target]:target:' \
                        '--target[Cloud vault target]:target:' \
                        '--to[Cloud vault target]:target:' \
                        '--force[Bypass secret confirmation prompts and force syncing]' \
                        '-f[Bypass secret confirmation prompts and force syncing]' \
                        '--scan-secrets[Scan target for secrets before adding]' \
                        '--scan[Scan target for secrets before adding]' \
                        '--no-scan[Skip scanning for secrets]' \
                        '--guard[Enable safety guard scanning for DBs and locks]' \
                        '--no-guard[Disable safety guard scanning for DBs and locks]' \
                        '1:file or directory:_files'
                    ;;
                link)
                    _arguments \
                        '--tag[Filter tags]:tags:' \
                        '-t[Filter tags]:tags:' \
                        '--group[Filter groups]:groups:' \
                        '-g[Filter groups]:groups:' \
                        '--force[Overwrite or skip confirmation prompts]' \
                        '-f[Overwrite or skip confirmation prompts]' \
                        '1:local destination:_files' \
                        '2:cloud target:'
                    ;;
                status)
                    _arguments \
                        '--json[Output status in JSON format]' \
                        '-j[Output status in JSON format]' \
                        '--quiet[Suppress all output and return exit code only]' \
                        '-q[Suppress all output and return exit code only]' \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:'
                    ;;
                doctor)
                    _arguments \
                        '--fix[Automatically fix detected issues where safe]' \
                        '-f[Automatically fix detected issues where safe]'
                    ;;
                info)
                    _arguments \
                        '--json[Output information in JSON format]' \
                        '-j[Output information in JSON format]'
                    ;;
                diff)
                    _arguments \
                        '--backup[Compare against specific or latest backup snapshot]:backup timestamp:' \
                        '-b[Compare against specific or latest backup snapshot]:backup timestamp:' \
                        '--compare-profile[Compare against another profile]:target profile:' \
                        '-c[Compare against another profile]:target profile:' \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:' \
                        '1:managed file:_files'
                    ;;
                history)
                    _arguments \
                        '--json[Output history in JSON format]' \
                        '-j[Output history in JSON format]' \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:' \
                        '1:managed file:_files'
                    ;;
                rollback)
                    _arguments \
                        '--force[Skip confirmation and force rollback]' \
                        '-f[Skip confirmation and force rollback]' \
                        '1:target file:_files' \
                        '2:snapshot timestamp or index:'
                    ;;
                backup|snapshot)
                    _arguments \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:' \
                        '1:managed file:_files'
                    ;;
                edit)
                    _arguments \
                        '--no-backup[Skip pre-edit safety snapshot creation]' \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:' \
                        '1:managed file:_files'
                    ;;
                which)
                    _arguments \
                        '--json[Output inspection result in JSON format]' \
                        '-j[Output inspection result in JSON format]' \
                        '1:target path:_files'
                    ;;
                clean)
                    _arguments \
                        '--older-than[Filter snapshots older than duration (e.g. 30d, 7d, 24h)]:duration:' \
                        '--dry-run[Simulate deletion without removing files]' \
                        '-n[Simulate deletion without removing files]' \
                        '--force[Skip confirmation prompt]' \
                        '-f[Skip confirmation prompt]' \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:' \
                        '1:managed file or directory:_files'
                    ;;
                tree)
                    _arguments \
                        '--all-profiles[Show tree for all configured profiles]' \
                        '-a[Show tree for all configured profiles]' \
                        '--by-group[Group tree by groups and tags]' \
                        '--no-color[Disable ANSI color output]' \
                        '--json[Output tree in JSON format]' \
                        '--tag[Filter by tags]:tags:' \
                        '-t[Filter by tags]:tags:' \
                        '--group[Filter by groups]:groups:' \
                        '-g[Filter by groups]:groups:'
                    ;;
                config)
                    _arguments \
                        '1: :(set)' \
                        '2: :(MOSY_REMOTE_NAME MOSY_MOUNT_POINT MOSY_VFS_CACHE MOSY_CLOUD_DIR MOSY_BACKUP_EXT MOSY_LOG_LEVEL MOSY_DRY_RUN MOSY_SCAN_SECRETS MOSY_SAFETY_GUARD)'
                    ;;
            esac
            ;;
    esac
}
